# SmartPantry Cloud Backend Environment Variables Example
PORT=5000
NODE_ENV=production
AWS_REGION=us-east-1

# Managed Storage: Amazon DynamoDB
DYNAMODB_TABLE_NAME=smartpantry-inventory
DB_TYPE=dynamodb

# Managed Messaging: Amazon SNS
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:smartpantry-alerts

# Managed Object Storage: Amazon S3
S3_BUCKET_NAME=smartpantry-data-example